if(NOT DEFINED CLI OR NOT DEFINED TEST_ROOT OR NOT DEFINED CASE)
    message(FATAL_ERROR "CLI, TEST_ROOT and CASE are required")
endif()
# Every invocation gets fresh synthetic files. Keep failed-run evidence, and
# avoid recursive cleanup through a junction or a reused test directory.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef RUN)
set(WORK "${TEST_ROOT}/${RUN}")
file(MAKE_DIRECTORY "${WORK}/original")
set(SOURCE "${WORK}/source.bin")
set(VIDEO "${WORK}/original/archive.mkv")
set(OUTPUT "${WORK}/recovered.bin")
file(WRITE "${SOURCE}" "Synthetic legacy CLI recovery safety payload")
set(ENC_ARGS)
set(DEC_ARGS)
if(CASE MATCHES "encrypted|wrong_password")
    list(APPEND ENC_ARGS --encrypt --password synthetic-correct)
    list(APPEND DEC_ARGS --password synthetic-correct)
endif()
execute_process(COMMAND "${CLI}" encode --input "${SOURCE}" --output "${VIDEO}"
    --no-probe --reliability-profile high-capacity ${ENC_ARGS}
    RESULT_VARIABLE STATUS OUTPUT_QUIET ERROR_VARIABLE ERROR)
if(NOT STATUS STREQUAL "0")
    message(FATAL_ERROR "Fixture encode failed: ${STATUS}: ${ERROR}")
endif()
file(SHA256 "${VIDEO}" VIDEO_BEFORE)
file(SHA256 "${SOURCE}" SOURCE_SHA)
set(POSITIVE FALSE)
set(ALIAS FALSE)
if(CASE MATCHES "^success")
    set(POSITIVE TRUE)
elseif(CASE STREQUAL "same")
    set(OUTPUT "${VIDEO}")
    set(ALIAS TRUE)
elseif(CASE STREQUAL "relative")
    set(OUTPUT "original/../original/./archive.mkv")
    set(ALIAS TRUE)
elseif(CASE STREQUAL "hardlink")
    file(CREATE_LINK "${VIDEO}" "${OUTPUT}" RESULT LINK_ERROR)
    if(NOT LINK_ERROR STREQUAL "0")
        message(FATAL_ERROR "Hardlink fixture failed: ${LINK_ERROR}")
    endif()
    set(ALIAS TRUE)
elseif(CASE STREQUAL "junction")
    file(TO_NATIVE_PATH "${WORK}/alias" LINK_NATIVE)
    file(TO_NATIVE_PATH "${WORK}/original" ORIGINAL_NATIVE)
    execute_process(COMMAND cmd /c mklink /J "${LINK_NATIVE}" "${ORIGINAL_NATIVE}"
        RESULT_VARIABLE LINK_STATUS OUTPUT_QUIET ERROR_VARIABLE LINK_ERROR)
    if(NOT LINK_STATUS STREQUAL "0")
        message(FATAL_ERROR "Junction fixture failed: ${LINK_ERROR}")
    endif()
    set(OUTPUT "${WORK}/alias/archive.mkv")
    set(ALIAS TRUE)
elseif(NOT CASE MATCHES "^wrong_password")
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()
if(NOT ALIAS AND NOT CASE STREQUAL "wrong_password_new")
    file(WRITE "${OUTPUT}" "existing-sentinel\n")
    file(SHA256 "${OUTPUT}" BEFORE)
endif()
if(CASE MATCHES "^wrong_password")
    set(DEC_ARGS --password synthetic-wrong)
endif()
execute_process(COMMAND "${CLI}" decode --input "${VIDEO}" --output "${OUTPUT}" ${DEC_ARGS}
    WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE ERROR)
file(SHA256 "${VIDEO}" VIDEO_AFTER)
if(NOT VIDEO_AFTER STREQUAL VIDEO_BEFORE)
    message(FATAL_ERROR "Source video changed: ${VIDEO_BEFORE} -> ${VIDEO_AFTER}")
endif()
if(POSITIVE)
    if(NOT STATUS STREQUAL "0")
        message(FATAL_ERROR "Recovery failed: ${STATUS}: ${ERROR}")
    endif()
    file(SHA256 "${OUTPUT}" AFTER)
    if(NOT AFTER STREQUAL SOURCE_SHA)
        message(FATAL_ERROR "Recovered bytes do not match original")
    endif()
else()
    if(STATUS STREQUAL "0")
        message(FATAL_ERROR "Unsafe recovery succeeded: ${STDOUT}")
    endif()
    if(ALIAS)
        if(NOT ERROR MATCHES "invalid arguments")
            message(FATAL_ERROR "Alias did not fail with invalid arguments: ${ERROR}")
        endif()
    elseif(CASE STREQUAL "wrong_password_new")
        if(EXISTS "${OUTPUT}")
            message(FATAL_ERROR "Failed recovery left a final output")
        endif()
    else()
        file(SHA256 "${OUTPUT}" AFTER)
        if(NOT AFTER STREQUAL BEFORE)
            message(FATAL_ERROR "Sentinel changed: ${BEFORE} -> ${AFTER}")
        endif()
    endif()
endif()
file(GLOB PARTIALS "${WORK}/.vidstorex-part-*" "${WORK}/original/.vidstorex-part-*")
if(PARTIALS)
    message(FATAL_ERROR "Recovery leaked partial files: ${PARTIALS}")
endif()
